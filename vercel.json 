{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "kaara_backend": {
      "root": "kaara_backend",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "kaara_backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}